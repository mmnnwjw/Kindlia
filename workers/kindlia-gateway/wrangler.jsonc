{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kindlia-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "routes": [],
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "IMAGE_HOSTS": "*.mitemin.net,*.pximg.net,images-cn.ssl-images-amazon.cn,images-na.ssl-images-amazon.com,images-fe.ssl-images-amazon.com,m.media-amazon.com,images.amazon.com,cdn.kdkw.jp,*.bookwalker.jp,*.novelia.cc"
  }
  // 自行填写上方 routes，或使用部署工具 --domain 指定；示例：
  // "routes": [{ "pattern": "reader.example.com", "custom_domain": true }]
  // GATEWAY_TOKEN 使用 npx wrangler secret put GATEWAY_TOKEN 设置，不写入本文件。
}
